# Mallkit Admin 环境变量模板
# 复制为 .env 或填进云托管控制台「服务设置 → 环境变量」。所有值均为示例，不要提交真实密钥。

# ===== 服务 =====
# HTTP 监听端口。云托管默认 80。
PORT=80
# production / development
NODE_ENV=production

# ===== CloudBase =====
# 云开发环境 ID。未配置时回退到 SCF_NAMESPACE。
TCB_ENV=your-env-id
# 腾讯云 API 密钥。容器型云托管不会自动注入，必须手工配置，
# 否则数据库调用会挂 30 秒。获取地址：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
# 临时密钥场景才需要
TENCENTCLOUD_SESSIONTOKEN=
# 兼容别名，TENCENTCLOUD_* 未设置时使用
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ===== 管理员登录 =====
# 管理员用户名，留空按默认处理
ADMIN_USERNAME=admin
# 管理员密码。未配置时登录直接拒绝，没有兜底密码。
ADMIN_PASSWORD=
# 登录 Token 的 HMAC 签名密钥。未配置时用随机值，重启会丢登录态，生产必须配。
TOKEN_SECRET=
# 可选：TOTP 二次验证密钥（base32）。留空则不启用 MFA。
ADMIN_TOTP_SECRET=

# ===== 微信小程序 / 微信支付 =====
# 小程序 AppID / AppSecret（用于 access_token、小程序码、发货信息上报）
WX_APPID=touristappid
WX_APPSECRET=
# 生成小程序码时的环境版本：release / trial / develop
WX_QRCODE_ENV=release
# 微信支付商户号与 API 证书（退款、发货上报签名用）
WX_MCH_ID=
WX_MCH_SERIAL_NO=
WX_MCH_PRIVATE_KEY=

# ===== 对象存储（COS，云存储管理页用）=====
# Bucket 名。留空则按 {hash}-{envId}-{appId} 推断。
COS_BUCKET=
# Bucket 所在地域，例如 ap-shanghai / ap-guangzhou
COS_REGION=ap-shanghai

# ===== AI 运营助手（可选，不配则助手接口返回提示、其余功能不受影响）=====
# OpenAI 兼容网关地址，例如 https://ai-gateway.example.com/v1
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
# 模型名，留空用内置默认值
AI_GATEWAY_MODEL=
# 单次对话最多执行几轮工具调用（默认 3，受云托管 60 秒网关超时约束）
ASSISTANT_MAX_TOOL_ROUNDS=3
# 单次对话软超时毫秒数（默认 55000，需小于网关硬超时）
ASSISTANT_TIMEOUT_MS=55000

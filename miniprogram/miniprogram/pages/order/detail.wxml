<!-- pages/order/detail.wxml - 订单详情 V2 -->

<view wx:if="{{isLoading}}" class="loading-page">
  <text class="text-hint">加载中...</text>
</view>

<view wx:elif="{{order}}" class="page">

  <!-- 状态横幅 -->
  <view class="status-banner {{order.status}}">
    <text class="status-icon">
      {{order.status === 'pending_payment' ? '⏳' :
        order.status === 'paid' ? '📦' :
        order.status === 'shipped' ? '🚚' :
        order.status === 'completed' ? '✅' :
        order.status === 'refund_pending' ? '🔄' :
        order.status === 'refunded' ? '💰' : '❌'}}
    </text>
    <text class="status-text">
      {{order.status === 'pending_payment' ? '等待支付' :
        order.status === 'paid' ? '商家备货中' :
        order.status === 'shipped' ? '商品配送中' :
        order.status === 'completed' ? '订单已完成' :
        order.status === 'refund_pending' ? '退款审核中' :
        order.status === 'refunded' ? '退款成功' : '订单已取消'}}
    </text>
    <text class="status-sub">
      {{order.status === 'pending_payment' ? '请在15分钟内完成支付' :
        order.status === 'paid' ? '商家正在为您打包' :
        order.status === 'shipped' ? '商品已发出，请注意查收' :
        order.status === 'completed' ? '感谢您的购买' :
        order.status === 'refund_pending' ? '商家将在1-3个工作日内处理' :
        order.status === 'refunded' ? '款项将原路退回，请注意查收' : '订单已关闭'}}
    </text>
  </view>

  <!-- 快递信息（已发货时显示） -->
  <!-- 多包裹：order.packages 有值时循环显示 -->
  <view class="section" wx:if="{{order.packages && order.packages.length > 1}}">
    <text class="section-title">物流信息（共{{order.packages.length}}个包裹）</text>
    <view wx:for="{{order.packages}}" wx:key="index" class="tracking-pkg-block">
      <view class="tracking-row">
        <text class="tracking-label">包裹{{index + 1}}·{{item.expressCompany || '快递'}}</text>
        <text class="tracking-num">{{item.expressNo}}</text>
        <view class="btn-copy-track" bindtap="onCopyTracking" data-index="{{index}}">复制</view>
      </view>
    </view>
    <view class="tracking-row" style="margin-top:16rpx;">
      <view class="btn-track-query" bindtap="onTrackLogistics">
        <text>查看物流轨迹</text>
      </view>
    </view>
  </view>
  <!-- 单包裹：兼容旧数据 -->
  <view class="section" wx:elif="{{order.expressNo || order.trackingNumber}}">
    <view class="tracking-row">
      <text class="tracking-label">{{order.expressCompany || '快递'}}单号</text>
      <text class="tracking-num">{{order.expressNo || order.trackingNumber}}</text>
      <view class="btn-copy-track" bindtap="onCopyTracking">复制</view>
    </view>
    <view class="tracking-row" style="margin-top:16rpx;">
      <view class="btn-track-query" bindtap="onTrackLogistics">
        <text>查看物流轨迹</text>
      </view>
    </view>
  </view>

  <!-- 收货地址 / 自提联系人（自提单只有称呼+手机号，无地址行） -->
  <view class="section" wx:if="{{order.shippingAddress}}">
    <view class="addr-row">
      <text class="addr-icon">{{order.shippingAddress.province ? '📍' : '🏪'}}</text>
      <view class="addr-info">
        <view class="addr-top">
          <text class="addr-name">{{order.shippingAddress.name}}</text>
          <text class="addr-phone">{{order.shippingAddress.phone}}</text>
        </view>
        <text class="addr-detail" wx:if="{{order.shippingAddress.province}}">{{order.shippingAddress.province}}{{order.shippingAddress.city}}{{order.shippingAddress.district}} {{order.shippingAddress.detail}}</text>
        <text class="addr-detail" wx:else>到店自提</text>
      </view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="section">
    <text class="section-title">商品清单</text>
    <view wx:for="{{order.items}}" wx:key="productId" class="order-product" bindtap="onProductTap" data-id="{{item.productId}}">
      <image class="product-img" src="{{item.image}}" mode="aspectFill" />
      <view class="product-info">
        <text class="product-name">{{item.productName || item.name}}</text>
        <text class="product-qty">×{{item.quantity}} {{item.unit}}</text>
      </view>
      <text class="product-total">¥{{item.totalPrice}}</text>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="section">
    <text class="section-title">费用明细</text>
    <view class="fee-row">
      <text class="fee-label">商品合计</text>
      <text class="fee-value">¥{{order.subtotal}}</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">运费</text>
      <text class="fee-value {{order.shippingFee == 0 ? 'free-ship' : ''}}">
        {{order.shippingFee == 0 ? '免运费' : '¥' + order.shippingFee}}
      </text>
    </view>
    <view class="fee-row" wx:if="{{order.discountAmount > 0}}">
      <text class="fee-label">优惠码减免</text>
      <text class="fee-value discount">-¥{{order.discountAmount}}</text>
    </view>
    <view class="fee-divider"></view>
    <view class="fee-row total-row">
      <text class="fee-label-bold">实付金额</text>
      <text class="fee-total">¥{{order.finalPrice}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <text class="section-title">订单信息</text>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order._id}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{createTimeText}}</text>
    </view>
    <view class="info-row" wx:if="{{order.paymentTime}}">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{payTimeText}}</text>
    </view>
    <view class="info-row" wx:if="{{order.transactionId}}">
      <text class="info-label">微信支付号</text>
      <text class="info-value info-value-small">{{order.transactionId}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="info-label">买家留言</text>
      <text class="info-value">{{order.remark}}</text>
    </view>
  </view>

  <view style="height: 160rpx;"></view>

</view>

<!-- 底部操作栏 -->
<view class="bottom-bar" wx:if="{{order}}">
  <!-- 待支付：去支付 -->
  <block wx:if="{{order.status === 'pending_payment'}}">
    <button class="btn-secondary" bindtap="onCancelOrder">取消订单</button>
    <button class="btn-pay" bindtap="onContinuePay">去支付 ¥{{order.finalPrice}}</button>
  </block>
  <!-- 待发货：申请退款 -->
  <block wx:elif="{{order.status === 'paid'}}">
    <button class="btn-refund" bindtap="onApplyRefund">申请退款</button>
  </block>
  <!-- 已发货：确认收货 + 申请退款 -->
  <block wx:elif="{{order.status === 'shipped'}}">
    <button class="btn-refund" bindtap="onApplyRefund">申请退款</button>
    <button class="btn-pay" bindtap="onConfirmReceive">确认收货</button>
  </block>
  <!-- 退款审核中：提示 -->
  <block wx:elif="{{order.status === 'refund_pending'}}">
    <button class="btn-disabled" disabled>退款审核中...</button>
  </block>
  <!-- 已完成：再次购买 + 去评价 -->
  <block wx:elif="{{order.status === 'completed'}}">
    <button class="btn-secondary" bindtap="onBuyAgain">再次购买</button>
    <button class="btn-pay" bindtap="onGoReview">去评价</button>
  </block>
</view>

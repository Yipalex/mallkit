<!-- pages/order/pay.wxml - 订单确认支付页面 -->

<view class="page">

  <!-- 配送方式选择 -->
  <view class="section card">
    <text class="section-title">配送方式</text>
    <view class="shipping-tabs">
      <view class="shipping-tab {{shippingMethod === 'delivery' ? 'active' : ''}}" bindtap="onSelectDelivery">
        <text class="shipping-tab-icon">🚚</text>
        <text class="shipping-tab-label">快递配送</text>
      </view>
      <view class="shipping-tab {{shippingMethod === 'pickup' ? 'active' : ''}}" bindtap="onSelectPickup">
        <text class="shipping-tab-icon">🏪</text>
        <text class="shipping-tab-label">到店自提</text>
      </view>
    </view>
  </view>

  <!-- 收货地址（快递时显示） -->
  <view wx:if="{{shippingMethod === 'delivery'}}" class="section card" bindtap="onChooseAddress">
    <view wx:if="{{address}}" class="address-info">
      <view class="address-top flex-between">
        <text class="addr-name">{{address.name}}</text>
        <text class="addr-phone">{{address.phone}}</text>
      </view>
      <text class="addr-detail text-secondary">{{address.province}}{{address.city}}{{address.district}} {{address.detail}}</text>
    </view>
    <view wx:else class="address-empty flex-center">
      <text class="text-hint">点击添加收货地址</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 自提信息（自提时显示） -->
  <view wx:if="{{shippingMethod === 'pickup'}}" class="section card pickup-info">
    <text class="pickup-title">🏪 自提门店</text>
    <text class="pickup-addr">{{pickupStore.address}}</text>
    <text class="pickup-tel">联系电话：{{pickupStore.phone}}</text>
    <text class="pickup-note">{{pickupStore.note}}</text>
  </view>

  <!-- 自提联系人（自提时必填） -->
  <view wx:if="{{shippingMethod === 'pickup'}}" class="section card">
    <text class="section-title">自提联系人</text>
    <view class="pickup-row">
      <text class="pickup-label">称呼</text>
      <input
        class="pickup-input"
        placeholder="请输入您的称呼"
        value="{{pickupContact.name}}"
        bindinput="onPickupInput"
        data-field="name"
        maxlength="20"
      />
    </view>
    <view class="pickup-row">
      <text class="pickup-label">手机号</text>
      <input
        class="pickup-input"
        placeholder="请输入手机号"
        type="number"
        maxlength="11"
        value="{{pickupContact.phone}}"
        bindinput="onPickupInput"
        data-field="phone"
      />
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="section card">
    <text class="section-title">商品清单</text>
    <view wx:for="{{items}}" wx:key="productId" class="order-item flex-between">
      <image class="item-img" src="{{item.image}}" mode="aspectFill" />
      <view class="item-info flex-1">
        <text class="item-name text-ellipsis">{{item.name}}</text>
        <text class="item-price text-hint">¥{{item.price}}/{{item.unit}}</text>
      </view>
      <text class="item-qty text-secondary">×{{item.quantity}}</text>
      <text class="item-total">¥{{item.subtotal}}</text>
    </view>
  </view>

  <!-- 我的优惠券（已领取可用的）-->
  <view class="section card" wx:if="{{myCoupons.length > 0}}">
    <view class="flex-between" style="margin-bottom: 16rpx;">
      <text class="section-title">我的优惠券</text>
      <text class="text-hint" style="font-size: 24rpx;">点击使用</text>
    </view>
    <view
      wx:for="{{myCoupons}}"
      wx:key="_id"
      class="my-coupon-item {{selectedCouponId === item._id ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}"
      bindtap="onSelectCoupon"
      data-id="{{item._id}}"
      data-disabled="{{item.disabled}}"
    >
      <view class="coupon-left">
        <text class="coupon-amount">
          <text class="coupon-symbol" wx:if="{{item.discountType === 'fixed'}}">¥</text>{{item.discountValue}}<text class="coupon-symbol" wx:if="{{item.discountType === 'percent'}}">%</text>
        </text>
        <text class="coupon-min" wx:if="{{item.minPurchase > 0}}">满¥{{item.minPurchase}}可用</text>
        <text class="coupon-min" wx:else>无门槛</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-name">{{item.name || '优惠券'}}</text>
        <text class="coupon-desc text-hint">{{item.disabledReason || item.description || ''}}</text>
      </view>
      <view class="coupon-check">{{selectedCouponId === item._id ? '✓' : ''}}</view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section card">
    <text class="section-title">买家留言</text>
    <textarea
      class="remark-input"
      placeholder="如有特殊要求请备注..."
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="200"
    />
  </view>

  <!-- 费用明细 -->
  <view class="section card">
    <view class="fee-row flex-between">
      <text class="fee-label text-secondary">商品合计</text>
      <text class="fee-value">¥{{subtotal}}</text>
    </view>
    <view class="fee-row flex-between">
      <text class="fee-label text-secondary">运费</text>
      <text class="fee-value {{shippingFee == '0.00' ? 'text-primary' : ''}}">
        {{shippingFee == '0.00' ? '免运费' : '¥' + shippingFee}}
      </text>
    </view>
    <view class="fee-row flex-between" wx:if="{{selectedCouponInfo}}">
      <text class="fee-label text-secondary">优惠券减免</text>
      <text class="fee-value text-accent">-¥{{selectedCouponInfo.discountAmount}}</text>
    </view>
    <view class="divider"></view>
    <view class="fee-row flex-between">
      <text class="fee-label" style="font-weight: bold;">实付金额</text>
      <text class="final-price">¥{{finalPrice}}</text>
    </view>
  </view>

  <view style="height: 160rpx;"></view>

</view>

<!-- 底部支付按钮 -->
<view class="pay-bar safe-area-bottom flex-between">
  <view>
    <text class="pay-label">实付</text>
    <text class="pay-price">¥{{finalPrice}}</text>
  </view>
  <button
    class="btn-pay {{isCreatingOrder ? 'disabled' : ''}}"
    bindtap="onPay"
    disabled="{{isCreatingOrder}}"
  >
    {{isCreatingOrder ? '处理中...' : '微信支付'}}
  </button>
</view>

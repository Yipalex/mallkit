/* pages/order/pay.wxss */

.page { background: var(--color-bg); padding: 16rpx; padding-bottom: 180rpx; }
.section {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: var(--color-white);
  border-radius: var(--border-radius-base);
  box-shadow: var(--shadow-sm);
}
.section-title { display: block; font-size: var(--font-size-base); font-weight: bold; margin-bottom: 20rpx; }

/* 地址 */
.address-info { flex: 1; }
.address-top { margin-bottom: 12rpx; }
.addr-name { font-size: var(--font-size-lg); font-weight: bold; margin-right: 24rpx; }
.addr-phone { font-size: var(--font-size-base); color: var(--color-text-secondary); }
.addr-detail { display: block; font-size: var(--font-size-sm); color: var(--color-text-secondary); line-height: 1.5; }
.address-empty { padding: 20rpx 0; }
.arrow { font-size: 40rpx; color: var(--color-text-hint); margin-left: 16rpx; }

/* 订单商品 */
.order-item { padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border); }
.order-item:last-child { border-bottom: none; }
.item-img { width: 100rpx; height: 100rpx; border-radius: var(--border-radius-sm); margin-right: 16rpx; flex-shrink: 0; }
.item-name { display: block; font-size: var(--font-size-base); margin-bottom: 8rpx; }
.item-price { display: block; font-size: var(--font-size-sm); }
.item-qty { margin: 0 16rpx; color: var(--color-text-secondary); }
.item-total { font-size: var(--font-size-base); font-weight: bold; color: var(--color-accent); }

/* 配送方式 */
.shipping-tabs { display: flex; gap: 20rpx; }
.shipping-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--border-radius-base);
  gap: 8rpx;
}
.shipping-tab.active { border-color: var(--color-primary); background: rgba(46,125,50,0.06); }
.shipping-tab-icon { font-size: 40rpx; }
.shipping-tab-label { font-size: var(--font-size-sm); color: var(--color-text-secondary); }
.shipping-tab.active .shipping-tab-label { color: var(--color-primary); font-weight: bold; }

/* 自提信息 */
.pickup-info { background: #f0f7f0; }
.pickup-title { display: block; font-size: var(--font-size-base); font-weight: bold; color: var(--color-primary); margin-bottom: 12rpx; }
.pickup-addr { display: block; font-size: var(--font-size-base); margin-bottom: 8rpx; }
.pickup-tel { display: block; font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-bottom: 8rpx; }
.pickup-note { display: block; font-size: var(--font-size-xs); color: var(--color-accent); }

/* 自提联系人输入 */
.pickup-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.pickup-row:last-child { border-bottom: none; }
.pickup-label { width: 140rpx; font-size: var(--font-size-base); flex-shrink: 0; }
.pickup-input { flex: 1; font-size: var(--font-size-base); }

/* 备注 */
.remark-input {
  width: 100%;
  min-height: 100rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--border-radius-sm);
  padding: 16rpx;
  font-size: var(--font-size-sm);
  box-sizing: border-box;
}

/* 费用明细 */
.fee-row { padding: 10rpx 0; }
.fee-label { font-size: var(--font-size-base); }
.fee-value { font-size: var(--font-size-base); }
.final-price { font-size: var(--font-size-xl); font-weight: bold; color: var(--color-accent); }

/* 底部支付栏 */
.pay-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-white);
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
}
.pay-label { font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-right: 8rpx; }
.pay-price { font-size: var(--font-size-xl); font-weight: bold; color: var(--color-accent); }
.btn-pay {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: white;
  border-radius: var(--border-radius-round);
  font-size: var(--font-size-lg);
  padding: 0 60rpx;
  height: 88rpx;
}
.btn-pay::after { border: none; }
.btn-pay.disabled { background: #ccc; }

/* 我的优惠券卡片 */
.my-coupon-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #fff5e6 0%, #fffaf0 100%);
  border: 2rpx solid #ffd699;
  border-radius: 12rpx;
  position: relative;
}
.my-coupon-item.selected {
  border-color: #f5a623;
  background: linear-gradient(90deg, #ffe0b3 0%, #fff5e6 100%);
}
.my-coupon-item.disabled {
  opacity: 0.5;
  background: #f5f5f5;
  border-color: #ddd;
}
.coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
  padding-right: 20rpx;
  border-right: 2rpx dashed #ffd699;
}
.coupon-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #f5a623;
  line-height: 1.1;
}
.coupon-symbol {
  font-size: 24rpx;
}
.coupon-min {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.coupon-right {
  flex: 1;
  padding: 0 20rpx;
}
.coupon-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}
.coupon-desc {
  display: block;
  font-size: 22rpx;
  margin-top: 4rpx;
}
.coupon-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f5a623;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.my-coupon-item:not(.selected) .coupon-check {
  background: transparent;
  border: 2rpx solid #ccc;
}

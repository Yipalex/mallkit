<!-- pages/review/add.wxml - 商品评价页面 -->

<view class="page">

  <!-- 商品信息 -->
  <view class="product-info" wx:if="{{product}}">
    <image class="product-image" src="{{product.mainImage}}" mode="aspectFill" />
    <view class="product-details">
      <text class="product-name">{{product.name}}</text>
      <text class="product-desc">{{product.description}}</text>
    </view>
  </view>

  <!-- 评分区域 -->
  <view class="rating-section">
    <text class="section-title">商品评分</text>
    <view class="stars-container">
      <text
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="star {{rating >= item ? 'filled' : ''}}"
        bindtap="onSelectStar"
        data-star="{{item}}"
      >★</text>
    </view>
    <text class="rating-text">{{ratingTexts[rating - 1] || '请评分'}}</text>
  </view>

  <!-- 评价内容 -->
  <view class="content-section">
    <text class="section-title">评价内容</text>
    <textarea
      class="review-input"
      placeholder="分享你的使用体验吧..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
      auto-height
    />
    <view class="char-count">{{content.length}}/500</view>
  </view>

  <!-- 添加图片 -->
  <view class="images-section">
    <text class="section-title">添加图片</text>
    <view class="images-grid">
      <view
        wx:for="{{images}}"
        wx:key="*this"
        class="image-item"
      >
        <image class="image-preview" src="{{item}}" mode="aspectFill" />
        <view class="image-remove" bindtap="onRemoveImage" data-index="{{index}}">×</view>
      </view>
      <view class="image-add" wx:if="{{images.length < 9}}" bindtap="onAddImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="btn-submit" bindtap="onSubmit" disabled="{{!rating || !content}}">
      {{rating && content ? '提交评价' : '请完成评分和评价内容'}}
    </button>
  </view>

</view>

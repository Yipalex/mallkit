/* pages/login/index.wxss - 登录引导页面样式 */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F1F8E9 0%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 顶部装饰 */
.login-decoration {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(46, 125, 50, 0.08);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 0;
}

.decoration-icon {
  font-size: 200rpx;
  opacity: 0.3;
}

/* 主体内容 */
.login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 80rpx;
  z-index: 1;
}

/* Logo区域 */
.login-logo {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 12rpx;
}

.logo-subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 插图 */
.login-illustration {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.illustration-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.illustration-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

/* 登录说明 */
.login-tips {
  width: 100%;
  margin-bottom: 80rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.tip-item:last-child {
  border-bottom: none;
}

.tip-icon {
  width: 40rpx;
  height: 40rpx;
  background: var(--color-primary);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

/* 登录按钮 */
.login-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.btn-wechat-login {
  width: 100%;
  height: 96rpx;
  background: var(--color-primary);
  color: white;
  border-radius: var(--border-radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-lg);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.3);
  border: none;
}

.btn-wechat-login::after {
  border: none;
}

.btn-wechat-login[disabled] {
  opacity: 0.7;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

/* 隐私政策主动勾选区域 */
.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.agree-checkbox {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.agree-checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.agree-checkmark {
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
}

.agree-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-hint);
  line-height: 1.5;
  white-space: nowrap;
}

.agree-text .link {
  color: var(--color-primary);
  text-decoration: underline;
}

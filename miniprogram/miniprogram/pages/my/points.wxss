/* pages/my/points.wxss - 积分明细 */

.page { min-height: 100vh; background: var(--color-bg); position: relative; padding: 24rpx 32rpx 60rpx; box-sizing: border-box; }

.page-halo {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 300rpx;
  background: linear-gradient(165deg, #E3F3DC, #F8FBF6);
  pointer-events: none;
}

/* 当前积分卡 */
.head-card {
  position: relative;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(87, 141, 80, 0.12);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
  .head-card {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(32rpx);
    -webkit-backdrop-filter: blur(32rpx);
  }
}
.head-label { font-size: 22rpx; color: #8AA08D; }
.head-num { font-size: 64rpx; font-weight: 800; color: var(--color-text-primary); line-height: 1.2; }

/* 流水卡 */
.log-card {
  position: relative;
  margin-top: 28rpx;
  background: var(--color-white);
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  padding: 8rpx 32rpx;
}
.log-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.log-row:last-child { border-bottom: none; }
.log-info { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.log-desc { font-size: 26rpx; color: var(--color-text-primary); }
.log-time { font-size: 20rpx; color: var(--color-text-hint); }
.log-points { font-size: 30rpx; font-weight: 800; flex-shrink: 0; }
.log-points.plus { color: var(--color-primary); }
.log-points.minus { color: var(--color-text-secondary); }

/* 空状态 */
.empty-state {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 12rpx;
}
.empty-icon { font-size: 90rpx; }
.empty-title { font-size: var(--font-size-base); color: var(--color-text-primary); font-weight: 600; }
.empty-sub { font-size: var(--font-size-sm); color: var(--color-text-hint); }

.list-status { text-align: center; padding: 32rpx 0; }
.text-hint { font-size: 22rpx; color: var(--color-text-hint); }

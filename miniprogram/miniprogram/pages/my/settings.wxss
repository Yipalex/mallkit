/* pages/my/settings.wxss - 设置 */

.page { background: var(--color-bg); min-height: 100vh; padding: 56rpx 0 60rpx; display: flex; flex-direction: column; }

/* ===== 资料卡 ===== */
.profile-card {
  margin: 0 32rpx;
  background: var(--color-white);
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(87, 141, 80, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-primary);
  flex-shrink: 0;
}
.profile-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.profile-name { font-size: 30rpx; font-weight: 700; color: var(--color-text-primary); }
.profile-sub { font-size: 22rpx; color: var(--color-text-hint); }

/* 头像按钮：button 承载 open-type="chooseAvatar"，必须清掉微信默认样式，
   否则默认的宽度/边框/背景会把资料卡布局撑坏（见 CLAUDE.md「button 别参与布局」） */
.profile-avatar-btn {
  padding: 0;
  margin: 0;
  width: 104rpx;
  height: 104rpx;
  line-height: normal;
  background: transparent;
  border: none;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
}
.profile-avatar-btn::after { border: none; }
.profile-avatar-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(87, 141, 80, 0.14);
  box-sizing: border-box;
}
/* 昵称输入框：视觉上与原来的静态文本保持一致 */
.profile-name-input {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  min-height: 42rpx;
  line-height: 42rpx;
  width: 100%;
}
.row-arrow { font-size: 36rpx; color: var(--color-text-disabled); flex-shrink: 0; }

/* ===== 分组列表卡 ===== */
.menu-card {
  margin: 28rpx 32rpx 0;
  background: var(--color-white);
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  padding: 8rpx 32rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  width: 38rpx;
  height: 38rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}

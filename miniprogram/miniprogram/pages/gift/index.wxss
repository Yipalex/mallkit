/* pages/gift/index.wxss - 积分礼品 */

.page { background: var(--color-bg); min-height: 100vh; position: relative; padding-top: 24rpx; padding-bottom: 60rpx; }

/* 顶部浅绿渐晕 */
.page-halo {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 420rpx;
  background: linear-gradient(165deg, #E3F3DC, #F8FBF6);
}

/* ===== 玻璃积分卡 ===== */
.points-card {
  position: relative;
  margin: 32rpx 32rpx 0;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 44rpx;
  padding: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(87, 141, 80, 0.12);
  display: flex;
  align-items: center;
  gap: 28rpx;
}
@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
  .points-card {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(32rpx);
    -webkit-backdrop-filter: blur(32rpx);
  }
}
.points-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.points-label { font-size: 22rpx; color: #8AA08D; }
.points-num { font-size: 64rpx; font-weight: 800; color: var(--color-text-primary); line-height: 1.1; }
.points-actions { display: flex; flex-direction: column; gap: 14rpx; flex-shrink: 0; }
.btn-earn {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(92, 174, 82, 0.3);
}
/* 积分明细：绿色描边按钮 */
.btn-detail {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  text-align: center;
}

/* ===== 筛选 chips（一排显示，字号缩小） ===== */
.chips { position: relative; display: flex; gap: 12rpx; padding: 32rpx 32rpx 0; flex-wrap: nowrap; }
.chip {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--color-text-light);
  background: var(--color-white);
  border: 1rpx solid rgba(36, 52, 38, 0.1);
  border-radius: 28rpx;
  padding: 12rpx 22rpx;
  white-space: nowrap;
}
.chip.active {
  color: #fff;
  font-weight: 600;
  background: var(--color-ink);
  border-color: var(--color-ink);
}

/* ===== 礼品网格 ===== */
.gift-grid {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 28rpx 32rpx 0;
}
.gift-card {
  background: var(--color-white);
  border: 1rpx solid var(--color-border);
  border-radius: 36rpx;
  overflow: hidden;
}
.gift-card.dim { opacity: 0.65; }
.gift-img {
  width: 100%;
  height: 220rpx;
  background: var(--color-image-bg);
  border-bottom: 1rpx solid var(--color-divider);
  display: block;
}
.gift-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.gift-info { padding: 20rpx 24rpx 24rpx; display: flex; flex-direction: column; gap: 10rpx; }
.gift-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gift-footer { display: flex; justify-content: space-between; align-items: center; }
.gift-points { font-size: 26rpx; font-weight: 800; color: var(--color-accent); }
.gift-points-dim { color: var(--color-text-hint); }
.gift-points-unit { font-size: 20rpx; font-weight: 400; color: var(--color-text-hint); }
.btn-exchange {
  font-size: 21rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
  border-radius: 24rpx;
  padding: 10rpx 24rpx;
}
.btn-lack {
  font-size: 21rpx;
  font-weight: 700;
  color: var(--color-text-hint);
  border: 1rpx solid rgba(36, 52, 38, 0.12);
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 12rpx;
}
.empty-icon { font-size: 100rpx; }
.empty-title { font-size: var(--font-size-base); color: var(--color-text-primary); font-weight: 600; }
.empty-sub { font-size: var(--font-size-sm); color: var(--color-text-hint); }

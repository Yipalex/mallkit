<!-- pages/address/edit.wxml - 填写收货地址 -->
<view class="page">

  <view class="form-card">

    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>

    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>

    <!-- 省市区选择器 -->
    <picker mode="region" value="{{regionVal}}" bindchange="onRegionChange">
      <view class="form-row">
        <text class="form-label">所在地区</text>
        <text class="form-value {{form.province ? '' : 'placeholder'}}">
          {{form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择省市区'}}
        </text>
        <text class="form-arrow">›</text>
      </view>
    </picker>

    <view class="form-row">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="街道、楼栋、门牌号" value="{{form.detail}}" bindinput="onInput" data-field="detail" />
    </view>

  </view>

  <!-- 不支持配送提示 -->
  <view class="tip-card" wx:if="{{deliveryTip}}">
    <text class="tip-icon">⚠️</text>
    <text class="tip-text">{{deliveryTip}}</text>
  </view>

  <!-- 运费说明 -->
  <view class="fee-card" wx:if="{{shippingInfo}}">
    <text class="fee-icon">🚚</text>
    <view class="fee-info">
      <text class="fee-title">{{shippingInfo.label}}</text>
      <text class="fee-sub">{{shippingInfo.desc}}</text>
    </view>
    <text class="fee-price">{{shippingInfo.fee === 0 ? '包邮' : '¥' + shippingInfo.fee}}</text>
  </view>

  <view class="bottom-bar">
    <button class="btn-primary btn-save {{!canSave ? 'disabled' : ''}}" bindtap="onSave" disabled="{{!canSave}}">
      确认地址
    </button>
  </view>

</view>

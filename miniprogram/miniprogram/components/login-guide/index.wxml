<!-- components/login-guide/index.wxml - 登录引导组件 -->
<view class="login-guide-mask" wx:if="{{show}}" bindtap="onClose">
  <view class="login-guide-content" catchtap="noop">

    <!-- 关闭按钮 -->
    <view class="close-btn" bindtap="onClose">✕</view>

    <!-- 图标 -->
    <view class="login-icon">🔐</view>

    <!-- 标题 -->
    <text class="login-title">您还未登录</text>

    <!-- 说明 -->
    <text class="login-desc">登录后即可查看会员信息和享受专属服务</text>

    <!-- 登录按钮 -->
    <button class="btn-login" bindtap="onGoLogin">
      <text class="btn-icon">💚</text>
      <text>立即登录</text>
    </button>

  </view>
</view>

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 容器：完全透明，仅做定位 */
.popup-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
}

/* 图片本身即完整设计，宽度固定、高度自适应，背景透明 */
.popup-main-img {
  width: 600rpx;
  background: transparent;
}

/* 关闭按钮：图片下方居中（参考图样式） */
.popup-close {
  margin-top: 40rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-close-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
}

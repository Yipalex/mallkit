/* 悬浮毛玻璃胶囊底栏 */

.tabbar-wrap {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  z-index: 1000;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 玻璃胶囊：不支持 backdrop-filter 的机型降级为高不透明白底 */
.glass-bar {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 24rpx 64rpx rgba(36, 52, 38, 0.14);
}
@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
  .glass-bar {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(40rpx);
    -webkit-backdrop-filter: blur(40rpx);
  }
}

.tabbar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-radius: 56rpx;
  padding: 20rpx 16rpx 24rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tab-icon-box {
  position: relative;
  width: 76rpx;
  height: 52rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 购物车角标 */
.tab-badge {
  position: absolute;
  top: 0;
  right: 6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  background: #FF3B30;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  border: 2rpx solid #fff;
}

.tab-icon-box.active {
  background: rgba(92, 174, 82, 0.14);
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.tab-label {
  font-size: 20rpx;
  color: #9FB0A1;
  line-height: 1;
}

.tab-label.active {
  color: #5CAE52;
  font-weight: 700;
}


# Mallkit 小程序 — 云函数环境变量示例
#
# 这些变量在「微信开发者工具 → 云开发控制台 → 云函数 → 对应函数 → 配置 → 环境变量」
# 中逐个配置，不要提交真实值到仓库。下方按使用它的云函数分组。

# ---------------------------------------------------------------- order 云函数
# 小程序 AppSecret。用于换取 access_token，调用微信侧发货信息管理等接口。
# 来源：微信公众平台 → 开发管理 → 开发设置 → AppSecret
WX_APPSECRET=

# ------------------------------------------------------------ pay / payNotify
# 微信支付商户号（10 位数字）。来源：微信支付商户平台首页
WX_MCH_ID=

# 微信支付 APIv3 密钥（32 位）。商户平台 → 账户中心 → API 安全 → APIv3 密钥
# pay 用它加签，payNotify 用它解密支付回调，两个函数都要配且必须一致。
WX_API_V3_KEY=

# 商户 API 证书序列号。商户平台 → 账户中心 → API 安全 → API 证书
WX_MCH_SERIAL_NO=

# 商户 API 私钥（apiclient_key.pem 的完整内容）。
# 换行可以写成 \n，代码里会做归一化处理。
WX_MCH_PRIVATE_KEY=

# 微信支付公钥 ID（形如 PUB_KEY_ID_xxxxxxxx）。
# 商户平台 → 账户中心 → API 安全 → 微信支付公钥。用于验证回调签名。
WX_PAY_PUBLIC_KEY_ID=

# ------------------------------------------------------------- payNotify 云函数
# 企业微信群机器人 Webhook 地址（可选）。配置后新订单会推送到群里。
# 来源：企业微信群 → 群机器人 → 添加机器人 → 复制 Webhook 地址
# 不配置时推送会静默跳过，不影响下单主流程。
WEWORK_WEBHOOK_URL=

# ------------------------------------------------------------------ 还需手工改
# 以下值不是环境变量，是写死在代码里的常量，部署前必须改成你自己的：
#
#   miniprogram/app.js                   env: 'cloudbase-your-env-id'
#   project.config.json                  appid: 'touristappid'
#   cloudfunctions/order/index.js        WX_APPID
#   cloudfunctions/pay/index.js          APPID、notify_url（两处）
#   cloudfunctions/pay/index.js          支付描述里的商城名
#   cloudfunctions/product/index.js      STORAGE_CDN_DOMAIN
#   miniprogram/pages/product/detail.js  CDN_HOST

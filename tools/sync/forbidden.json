{
  "$comment": [
    "Generic privacy patterns applied to every sync and to this repository as a whole.",
    "These describe the SHAPE of secrets and personal data, never a concrete value,",
    "so this file is safe to publish. Project-specific literals (brand names, real",
    "phone numbers, a particular environment id) belong in the private pattern file",
    "that each upstream repository keeps under .github/mallkit/.",
    "",
    "Each entry: category (label shown on a hit), pattern (JS regex source),",
    "flags (default 'gi'), allow (regex list of literals that are known-safe)."
  ],
  "patterns": [
    {
      "category": "cn-mobile",
      "pattern": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
      "$note": "Mainland China mobile number. 13800138000 is the documented placeholder.",
      "allow": ["^13800138000$", "^13800000000$", "^15900000000$"]
    },
    {
      "category": "personal-email",
      "pattern": "[A-Za-z0-9._%+-]+@(?:gmail|qq|163|126|outlook|hotmail|foxmail|yeah|sina)\\.(?:com|net|cn)",
      "allow": ["@example\\."]
    },
    {
      "category": "cloudbase-env-id",
      "pattern": "cloudbase-[0-9a-z]{10,}",
      "$note": "A real CloudBase environment id. Templates use your-env-id.",
      "allow": ["^cloudbase-your-env-id$"]
    },
    {
      "category": "wechat-appid",
      "pattern": "\\bwx[0-9a-f]{16}\\b",
      "$note": "WeChat AppID. touristappid is the simulator placeholder and is allowed.",
      "allow": []
    },
    {
      "category": "tencent-secret-id",
      "pattern": "AKID[0-9A-Za-z]{28,}"
    },
    {
      "category": "tencent-app-id",
      "pattern": "(?<![0-9])1[2-9][0-9]{8}(?![0-9])",
      "$note": "Tencent Cloud APPID appearing inside bucket and service host names.",
      "allow": []
    },
    {
      "category": "private-key-block",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----"
    },
    {
      "category": "jwt",
      "pattern": "eyJ[A-Za-z0-9_-]{15,}\\.eyJ[A-Za-z0-9_-]{15,}"
    },
    {
      "category": "wecom-webhook",
      "pattern": "qyapi\\.weixin\\.qq\\.com[^\\s\"'`]*key=[0-9a-zA-Z-]+"
    },
    {
      "category": "uuid-token",
      "pattern": "\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b",
      "$note": "Bare UUIDs are how WeCom bot keys and similar credentials look.",
      "allow": ["^00000000-0000-0000-0000-000000000000$"]
    },
    {
      "category": "cloudbase-host",
      "pattern": "[A-Za-z0-9-]+\\.(?:run|app|service)\\.tcloudbase\\.com"
    },
    {
      "category": "cloudbase-storage-host",
      "pattern": "[A-Za-z0-9-]+\\.tcb\\.qcloud\\.la"
    },
    {
      "category": "edgeone-project-id",
      "pattern": "makers-[a-z0-9]{8,}"
    },
    {
      "category": "wechat-merchant-id",
      "pattern": "mch_?id[\"'`\\s:=]+[0-9]{8,}",
      "allow": ["mch_?id[\"'`\\s:=]+0+$"]
    },
    {
      "category": "wechat-cert-serial",
      "pattern": "serial_?(?:no|number)[\"'`\\s:=]+[0-9A-F]{30,}"
    },
    {
      "category": "signed-cos-url",
      "pattern": "[?&](?:q-sign-algorithm|sign)=[A-Za-z0-9%._-]{8,}"
    },
    {
      "category": "windows-user-path",
      "pattern": "[A-Za-z]:\\\\\\\\?Users\\\\\\\\?[A-Za-z0-9._-]+",
      "allow": ["Users\\\\+(?:your-name|USERNAME|<[A-Za-z]+>)"]
    },
    {
      "category": "local-project-path",
      "pattern": "[A-Za-z]:[\\\\/]{1,2}[0-9]{1,2}_[\\u4e00-\\u9fa5]+"
    },
    {
      "category": "github-token",
      "pattern": "gh[pousr]_[A-Za-z0-9]{30,}"
    },
    {
      "category": "generic-api-secret",
      "pattern": "(?:api[_-]?key|secret[_-]?key|access[_-]?token|apiclient_key)[\"'`\\s:=]+[A-Za-z0-9/+_-]{24,}",
      "allow": ["[\"'`\\s:=]+(?:your-|<|\\$\\{|process\\.env)"]
    }
  ]
}
